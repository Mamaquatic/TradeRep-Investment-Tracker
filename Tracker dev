
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Investment Tracker</title>
<style>
:root{--bg:#f4f6fa;--card:#fff;--text:#1c2333;--muted:#6b7488;--border:#e2e6ee;--accent:#2f6df6;--pos:#0f9d58;--neg:#d93025}
[data-theme="dark"]{--bg:#0f131b;--card:#181e2a;--text:#e8ecf4;--muted:#939bb0;--border:#2a3242;--accent:#5b8cff;--pos:#34c77b;--neg:#ff6b60}
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.45}
header{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:var(--card);border-bottom:1px solid var(--border)}
header h1{font-size:1.1rem;margin:0}
nav{display:flex;gap:4px;overflow-x:auto;padding:8px 10px;background:var(--card);border-bottom:1px solid var(--border)}
nav button{flex:0 0 auto;background:none;border:none;color:var(--muted);padding:8px 12px;border-radius:8px;font-size:.95rem;cursor:pointer}
nav button.active{background:var(--accent);color:#fff}
main{max-width:1000px;margin:0 auto;padding:12px}
.tab{display:none}.tab.active{display:block}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:12px}
.card h2{margin:0 0 10px;font-size:1.05rem}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}
.stat{background:var(--bg);border-radius:10px;padding:10px}
.stat .l{font-size:.75rem;color:var(--muted)}
.stat .v{font-size:1.15rem;font-weight:700}
.pos{color:var(--pos)}.neg{color:var(--neg)}.muted{color:var(--muted)}.small{font-size:.8rem}
.btn{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:8px 14px;cursor:pointer;font-size:.9rem}
.btn.sec{background:var(--bg);color:var(--text);border:1px solid var(--border)}
.btn.del{background:var(--neg)}
.mini{padding:3px 8px;font-size:.8rem}
input,select{width:100%;padding:8px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font-size:16px}
label{font-size:.8rem;color:var(--muted);display:block;margin-bottom:2px}
.form{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin-bottom:10px}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th,td{padding:7px 8px;text-align:right;border-bottom:1px solid var(--border);white-space:nowrap}
th:first-child,td:first-child{text-align:left}
th{color:var(--muted);font-weight:600;font-size:.78rem}
canvas{width:100%;height:220px;display:block}
details{border-bottom:1px solid var(--border);padding:8px 0}
summary{cursor:pointer;font-weight:600}
</style>
</head>
<body>
<header>
  <h1>📈 My Investment Tracker</h1>
  <button class="btn sec" id="themeBtn">🌓</button>
</header>
<nav id="nav">
  <button data-t="dash" class="active">Dashboard</button>
  <button data-t="trades">Trades</button>
  <button data-t="divs">Dividends</button>
  <button data-t="prices">Prices</button>
  <button data-t="backup">Backup & Help</button>
</nav>
<main>

<!-- DASHBOARD -->
<section id="dash" class="tab active">
  <div class="card"><h2>Overview (EUR)</h2><div class="grid" id="stats"></div></div>
  <div class="card"><h2>Allocation by type</h2><canvas id="chart"></canvas><div id="legend" class="small"></div></div>
  <div class="card"><h2>Holdings</h2>
    <div class="form"><div><label>Filter by account</label>
      <select id="fAcc"><option value="">All</option><option>PEA</option><option>CTO</option></select></div></div>
    <div class="tw"><table><thead><tr><th>Asset</th><th>Qty</th><th>Avg cost</th><th>Price</th><th>Value</th><th>Gain</th><th>%</th></tr></thead><tbody id="hold"></tbody></table></div>
  </div>
</section>

<!-- TRADES -->
<section id="trades" class="tab">
  <div class="card"><h2>Add a trade</h2>
    <div class="form">
      <div><label>Date</label><input type="date" id="tDate"></div>
      <div><label>Action</label><select id="tSide"><option>Buy</option><option>Sell</option></select></div>
      <div><label>Name</label><input id="tName" placeholder="e.g. Apple"></div>
      <div><label>Ticker</label><input id="tTick" placeholder="e.g. AAPL"></div>
      <div><label>Type</label><select id="tType"><option>Stock</option><option>ETF</option><option>Bond</option><option>Crypto</option></select></div>
      <div><label>Account</label><select id="tAcc"><option>PEA</option><option>CTO</option></select></div>
      <div><label>Quantity</label><input type="number" step="any" id="tQty"></div>
      <div><label>Price per unit (EUR)</label><input type="number" step="any" id="tPrice"></div>
      <div><label>Fees (EUR)</label><input type="number" step="any" id="tFee" value="0"></div>
    </div>
    <button class="btn" id="tAdd">Add trade</button>
  </div>
  <div class="card"><h2>History</h2>
    <div class="tw"><table><thead><tr><th>Date</th><th>Action</th><th>Asset</th><th>Acc.</th><th>Qty</th><th>Price</th><th>Fees</th><th></th></tr></thead><tbody id="tList"></tbody></table></div>
  </div>
</section>

<!-- DIVIDENDS -->
<section id="divs" class="tab">
  <div class="card"><h2>Add a dividend</h2>
    <div class="form">
      <div><label>Date received</label><input type="date" id="dDate"></div>
      <div><label>Ticker</label><input id="dTick" placeholder="e.g. AAPL"></div>
      <div><label>Gross amount (EUR)</label><input type="number" step="any" id="dGross"></div>
      <div><label>Withholding tax (EUR)</label><input type="number" step="any" id="dTax" value="0"></div>
    </div>
    <button class="btn" id="dAdd">Add dividend</button>
  </div>
  <div class="card"><h2>Dividend history</h2>
    <div class="small muted" id="dTotal"></div>
    <div class="tw"><table><thead><tr><th>Date</th><th>Ticker</th><th>Gross</th><th>Tax</th><th>Net</th><th></th></tr></thead><tbody id="dList"></tbody></table></div>
  </div>
</section>

<!-- PRICES -->
<section id="prices" class="tab">
  <div class="card"><h2>Current prices (EUR)</h2>
    <p class="small muted">Type the latest price for each asset you hold, then press Save. Crypto can be refreshed automatically.</p>
    <div class="form" id="pList"></div>
    <button class="btn" id="pSave">Save prices</button>
    <button class="btn sec" id="pCrypto">Refresh crypto (CoinGecko)</button>
    <div class="small muted" id="pMsg"></div>
  </div>
</section>

<!-- BACKUP -->
<section id="backup" class="tab">
  <div class="card"><h2>Backup</h2>
    <p class="small muted">Data is stored only in this browser. Export a file regularly and import it on other devices.</p>
    <button class="btn" id="exp">Export JSON</button>
    <input type="file" id="imp" accept=".json" style="margin-top:10px">
    <button class="btn del" id="wipe" style="margin-top:10px">Erase all data</button>
  </div>
  <div class="card"><h2>Glossary</h2><div id="gloss"></div></div>
</section>

</main>


<script>
(function(){
const KEY="trTracker_v1";
let S=load();
function load(){try{return Object.assign({trades:[],divs:[],prices:{},theme:"light"},JSON.parse(localStorage.getItem(KEY)||"{}"))}catch(e){return{trades:[],divs:[],prices:{},theme:"light"}}}
function save(){localStorage.setItem(KEY,JSON.stringify(S))}
const $=id=>document.getElementById(id);
const eur=n=>(n<0?"-":"")+"€"+Math.abs(n).toLocaleString("en-GB",{minimumFractionDigits:2,maximumFractionDigits:2});
const cls=n=>n>=0?"pos":"neg";
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&","<":"<",">":">",'"':"""}[c]));
const today=new Date().toISOString().slice(0,10);
["tDate","dDate"].forEach(i=>$(i).value=today);

/* Theme */
function applyTheme(){document.documentElement.setAttribute("data-theme",S.theme)}
$("themeBtn").onclick=()=>{S.theme=S.theme==="dark"?"light":"dark";save();applyTheme();render()};
applyTheme();

/* Tabs */
$("nav").onclick=e=>{
  const t=e.target.dataset.t;if(!t)return;
  document.querySelectorAll("nav button").forEach(b=>b.classList.toggle("active",b===e.target));
  document.querySelectorAll(".tab").forEach(s=>s.classList.toggle("active",s.id===t));
  render();
};

/* Positions (average cost method) */
function positions(acc){
  const P={};
  const list=S.trades.slice().sort((a,b)=>a.date.localeCompare(b.date));
  list.forEach(t=>{
    if(acc&&t.acc!==acc)return;
    const k=t.tick.toUpperCase();
    const p=P[k]=P[k]||{tick:k,name:t.name,type:t.type,qty:0,cost:0,realized:0,fees:0};
    p.name=t.name||p.name;p.type=t.type;p.fees+=t.fee;
    if(t.side==="Buy"){p.qty+=t.qty;p.cost+=t.qty*t.price+t.fee}
    else{
      const avg=p.qty>0?p.cost/p.qty:0;
      p.realized+=t.qty*t.price-t.fee-avg*t.qty;
      p.cost-=avg*t.qty;p.qty-=t.qty;
      if(p.qty<1e-9){p.qty=0;p.cost=0}
    }
  });
  return P;
}

/* Render */
function render(){renderDash();renderTrades();renderDivs();renderPrices()}

function renderDash(){
  const P=positions($("fAcc").value);
  const rows=Object.values(P).filter(p=>p.qty>0);
  let value=0,cost=0,realized=0,fees=0;
  Object.values(P).forEach(p=>{realized+=p.realized;fees+=p.fees});
  const byType={};
  $("hold").innerHTML=rows.map(p=>{
    const price=S.prices[p.tick]!=null?S.prices[p.tick]:p.cost/p.qty;
    const v=p.qty*price,g=v-p.cost,pc=p.cost?g/p.cost*100:0;
    value+=v;cost+=p.cost;byType[p.type]=(byType[p.type]||0)+v;
    return `<tr><td>${esc(p.name||p.tick)}<div class="small muted">${esc(p.tick)} · ${esc(p.type)}</div></td>
    <td>${+p.qty.toFixed(6)}</td><td>${eur(p.cost/p.qty)}</td><td>${eur(price)}</td><td>${eur(v)}</td>
    <td class="${cls(g)}">${eur(g)}</td><td class="${cls(pc)}">${pc.toFixed(2)}%</td></tr>`;
  }).join("")||`<tr><td colspan="7" class="muted">No holdings yet. Add a trade.</td></tr>`;
  const netDiv=S.divs.reduce((a,d)=>a+d.gross-d.tax,0);
  const unreal=value-cost;
  const stats=[
    ["Portfolio value",eur(value),""],
    ["Invested",eur(cost),""],
    ["Unrealised gain",eur(unreal),cls(unreal)],
    ["Return %",(cost?unreal/cost*100:0).toFixed(2)+"%",cls(unreal)],
    ["Realised gain",eur(realized),cls(realized)],
    ["Net dividends",eur(netDiv),"pos"],
    ["Total fees",eur(fees),""]
  ];
  $("stats").innerHTML=stats.map(s=>`<div class="stat"><div class="l">${s[0]}</div><div class="v ${s[2]}">${s[1]}</div></div>`).join("");
  drawChart(byType,value);
}

function drawChart(byType,total){
  const c=$("chart"),dpr=window.devicePixelRatio||1;
  const w=c.clientWidth||300,h=220;
  c.width=w*dpr;c.height=h*dpr;
  const x=c.getContext("2d");x.scale(dpr,dpr);x.clearRect(0,0,w,h);
  const colors=["#2f6df6","#0f9d58","#f4a300","#d93025","#8e44ad","#16a2b8"];
  const keys=Object.keys(byType);
  if(!total||!keys.length){x.fillStyle="#888";x.fillText("No data",10,20);$("legend").innerHTML="";return}
  let a=-Math.PI/2;const cx=w/2,cy=h/2,r=Math.min(w,h)/2-10;
  keys.forEach((k,i)=>{
    const ang=byType[k]/total*Math.PI*2;
    x.beginPath();x.moveTo(cx,cy);x.arc(cx,cy,r,a,a+ang);x.closePath();
    x.fillStyle=colors[i%colors.length];x.fill();a+=ang;
  });
  x.beginPath();x.arc(cx,cy,r*0.55,0,Math.PI*2);
  x.fillStyle=getComputedStyle(document.body).getPropertyValue("--card");x.fill();
  $("legend").innerHTML=keys.map((k,i)=>`<span style="color:${colors[i%colors.length]}">●</span> ${esc(k)} ${(byType[k]/total*100).toFixed(1)}% &nbsp; `).join("");
}
$("fAcc").onchange=renderDash;
window.addEventListener("resize",renderDash);

/* Trades */
$("tAdd").onclick=()=>{
  const t={id:Date.now(),date:$("tDate").value,side:$("tSide").value,name:$("tName").value.trim(),
    tick:$("tTick").value.trim().toUpperCase(),type:$("tType").value,acc:$("tAcc").value,
    qty:parseFloat($("tQty").value),price:parseFloat($("tPrice").value),fee:parseFloat($("tFee").value)||0};
  if(!t.date||!t.tick||!(t.qty>0)||!(t.price>=0)){alert("Please fill date, ticker, quantity and price.");return}
  if(t.side==="Sell"){
    const have=(positions(t.acc)[t.tick]||{qty:0}).qty;
    if(t.qty>have+1e-9){alert("You only hold "+have+" of "+t.tick+" in "+t.acc+".");return}
  }
  S.trades.push(t);save();
  ["tName","tTick","tQty","tPrice"].forEach(i=>$(i).value="");
  render();
};
function renderTrades(){
  $("tList").innerHTML=S.trades.slice().sort((a,b)=>b.date.localeCompare(a.date)).map(t=>
    `<tr><td>${t.date}</td><td class="${t.side==="Buy"?"pos":"neg"}">${t.side}</td><td>${esc(t.tick)}</td><td>${t.acc}</td>
    <td>${t.qty}</td><td>${eur(t.price)}</td><td>${eur(t.fee)}</td>
    <td><button class="btn del mini" data-del="${t.id}">✕</button></td></tr>`).join("")
    ||`<tr><td colspan="8" class="muted">No trades yet.</td></tr>`;
}
$("tList").onclick=e=>{
  const id=e.target.dataset.del;if(!id)return;
  if(confirm("Delete this trade?")){S.trades=S.trades.filter(t=>String(t.id)!==id);save();render()}
};

/* Dividends */
$("dAdd").onclick=()=>{
  const d={id:Date.now(),date:$("dDate").value,tick:$("dTick").value.trim().toUpperCase(),
    gross:parseFloat($("dGross").value),tax:parseFloat($("dTax").value)||0};
  if(!d.date||!d.tick||!(d.gross>0)){alert("Please fill date, ticker and gross amount.");return}
  S.divs.push(d);save();
  ["dTick","dGross"].forEach(i=>$(i).value="");$("dTax").value=0;
  render();
};
function renderDivs(){
  const g=S.divs.reduce((a,d)=>a+d.gross,0),t=S.divs.reduce((a,d)=>a+d.tax,0);
  $("dTotal").textContent=`Total gross ${eur(g)} · tax ${eur(t)} · net ${eur(g-t)}`;
  $("dList").innerHTML=S.divs.slice().sort((a,b)=>b.date.localeCompare(a.date)).map(d=>
    `<tr><td>${d.date}</td><td>${esc(d.tick)}</td><td>${eur(d.gross)}</td><td>${eur(d.tax)}</td><td class="pos">${eur(d.gross-d.tax)}</td>
    <td><button class="btn del mini" data-ddel="${d.id}">✕</button></td></tr>`).join("")
    ||`<tr><td colspan="6" class="muted">No dividends yet.</td></tr>`;
}
$("dList").onclick=e=>{
  const id=e.target.dataset.ddel;if(!id)return;
  if(confirm("Delete this dividend?")){S.divs=S.divs.filter(d=>String(d.id)!==id);save();render()}
};

/* Prices */
function renderPrices(){
  const P=positions();
  const rows=Object.values(P).filter(p=>p.qty>0);
  $("pList").innerHTML=rows.map(p=>
    `<div><label>${esc(p.tick)} (${esc(p.type)})</label><input type="number" step="any" data-p="${esc(p.tick)}" value="${S.prices[p.tick]!=null?S.prices[p.tick]:""}"></div>`).join("")
    ||`<span class="muted">Add a trade first.</span>`;
}
$("pSave").onclick=()=>{
  document.querySelectorAll("[data-p]").forEach(i=>{
    const v=parseFloat(i.value);if(!isNaN(v))S.prices[i.dataset.p]=v;
  });
  save();$("pMsg").textContent="Saved.";renderDash();
};
$("pCrypto").onclick=async()=>{
  const map={BTC:"bitcoin",ETH:"ethereum",SOL:"solana",XRP:"ripple",ADA:"cardano",DOGE:"dogecoin",LTC:"litecoin",DOT:"polkadot"};
  const P=positions();
  const cr=Object.values(P).filter(p=>p.qty>0&&p.type==="Crypto"&&map[p.tick]);
  if(!cr.length){$("pMsg").textContent="No supported crypto holdings (BTC, ETH, SOL, XRP, ADA, DOGE, LTC, DOT).";return}
  try{
    $("pMsg").textContent="Loading...";
    const ids=cr.map(p=>map[p.tick]).join(",");
    const r=await fetch("https://api.coingecko.com/api/v3/simple/price?ids="+ids+"&vs_currencies=eur");
    const j=await r.json();
    cr.forEach(p=>{if(j[map[p.tick]])S.prices[p.tick]=j[map[p.tick]].eur});
    save();$("pMsg").textContent="Crypto prices updated.";render();
  }catch(e){$("pMsg").textContent="Could not fetch prices (offline or blocked). Enter them manually."}
};

/* Backup */
$("exp").onclick=()=>{
  const b=new Blob([JSON.stringify(S,null,2)],{type:"application/json"});
  const a=document.createElement("a");a.href=URL.createObjectURL(b);
  a.download="tracker-backup-"+today+".json";a.click();
};
$("imp").onchange=e=>{
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{
    try{
      const d=JSON.parse(r.result);
      if(!Array.isArray(d.trades))throw 0;
      if(confirm("This replaces the data in this browser. Continue?")){
        S=Object.assign({trades:[],divs:[],prices:{},theme:S.theme},d);save();applyTheme();render();
      }
    }catch(x){alert("Invalid backup file.")}
  };
  r.readAsText(f);
};
$("wipe").onclick=()=>{
  if(confirm("Erase ALL data? This cannot be undone.")){S={trades:[],divs:[],prices:{},theme:S.theme};save();render()}
};

/* Glossary */
const G=[
["Average cost","The average price you paid per unit, fees included. Buy 1 at €100 and 1 at €120: average cost is €110. Gains on a sale are measured against it."],
["Stock","A small piece of ownership in a company."],
["ETF","A basket of many investments (for example thousands of companies) bought as a single item."],
["Bond","A loan to a government or company that pays you interest and returns your money at the end."],
["Crypto","Digital currency such as Bitcoin. Prices can swing a lot."],
["Ticker","A short code for an asset. Example: AAPL is Apple."],
["Dividend","A share of company profits paid to shareholders. Example: 100 shares x €0.50 = €50."],
["Withholding tax","Tax deducted from a dividend before you receive it. Example: €100 gross with €30 tax means €70 net."],
["Gross vs net","Gross is before tax; net is what you actually receive."],
["Unrealised gain","Profit or loss on assets you still hold, not yet sold."],
["Realised gain","Profit or loss locked in by selling."],
["PEA / CTO","Two account types (French context). PEA has tax advantages after 5 years; CTO is a standard securities account."],
["TER","Yearly fee an ETF charges, built into its price. Example: 0.20% on €10,000 = €20 per year."]
];
$("gloss").innerHTML=G.map(g=>`<details><summary>${g[0]}</summary><div class="small muted" style="padding-top:6px">${g[1]}</div></details>`).join("");

render();
})();
</script>
</body>
</html>
